{
  "name": "phasa",
  "version": "0.0.1",
  "private": true,
  "description": "Learn Thai from videos with Thai subtitles — Chrome extension.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test --grep-invert @network",
    "test:e2e:network": "wxt build && playwright test --grep @network",
    "spike:seg": "tsx scripts/spikes/segmentation.ts",
    "spike:seg:fetch": "tsx scripts/spikes/fetch-wisesight.ts",
    "spike:cues": "tsx scripts/spikes/cues-to-tsv.ts"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "~5.0.4",
    "wxt": "^0.21.4"
  }
}
